<joint name="Revolute 10" type="continuous">
  <origin xyz="0.02 0.0 0.0" rpy="0 0 0" />
  <parent link="Knuckle_left_1" />
  <child link="wheel_front_left_1" />
  <axis xyz="1.0 0.0 0.0" />
</joint>

<joint name="Revolute 11" type="continuous">
  <origin xyz="-0.0118 0.0 0.0" rpy="0 0 0" />
  <parent link="knuckle_right_1" />
  <child link="wheel_front_right_1" />
  <axis xyz="1.0 0.0 0.0" />
