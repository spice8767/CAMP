<gazebo><plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering"><left_joint>Revolute 20</left_joint><right_joint>Revolute 21</right_joint><left_steering_joint>Revolute 22</left_steering_joint><right_steering_joint>Revolute 23</right_steering_joint><kingpin_width>0.755</kingpin_width><steering_limit>0.8</steering_limit><wheel_base>2.124</wheel_base><wheel_radius>0.277</wheel_radius><min_velocity>-5</min_velocity><max_velocity>5</max_velocity><topic>/cmd_vel</topic></plugin></gazebo></robot>