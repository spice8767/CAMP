<?xml version="1.0" ?>
<robot name="CART" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!-- High-contrast bright safety orange body so the buggy stands out against dark asphalt -->
<gazebo reference="base_link">
  <visual>
    <material>
      <ambient>1.0 0.35 0.0 1.0</ambient>
      <diffuse>1.0 0.35 0.0 1.0</diffuse>
      <specular>0.6 0.6 0.6 1.0</specular>
    </material>
  </visual>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<!-- Clean white canopy roof for strong visibility from aerial/chase view -->
<gazebo reference="top_1">
  <visual>
    <material>
      <ambient>0.95 0.95 0.95 1.0</ambient>
      <diffuse>0.95 0.95 0.95 1.0</diffuse>
      <specular>0.8 0.8 0.8 1.0</specular>
    </material>
  </visual>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- Wheels in dark matte rubber black for realistic contrast with the orange body -->
<gazebo reference="wheel_front_left_1">
  <visual>
    <material>
      <ambient>0.12 0.12 0.12 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
    </material>
  </visual>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="wheel_front_right_1">
  <visual>
    <material>
      <ambient>0.12 0.12 0.12 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
    </material>
  </visual>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="wheel_back_left_1">
  <visual>
    <material>
      <ambient>0.12 0.12 0.12 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
    </material>
  </visual>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="wheel_back_right_1">
  <visual>
    <material>
      <ambient>0.12 0.12 0.12 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
    </material>
  </visual>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Knuckle_left_1">
  <visual>
    <material>
      <ambient>0.15 0.15 0.15 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
  </visual>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="knuckle_right_1">
  <visual>
    <material>
      <ambient>0.15 0.15 0.15 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
  </visual>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

</robot>
