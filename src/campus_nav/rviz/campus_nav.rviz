Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RealSense Camera Feed1
        - /Road Network1
        - /Campus Stops1
        - /saye Buggy (Live 3D Model)1
      Splitter Ratio: 0.55
    Tree Height: 550
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Cell Size: 50
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.05
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 600
        Y: 800
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/road_graph
      Name: Road Network
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/junction_markers
      Name: Junctions
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/stop_markers
      Name: Campus Stops
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/building_markers
      Name: Buildings
      Value: true
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: true
      Head Diameter: 1.0
      Head Symbol: Arrow
      Length: 1.0
      Line Style: Lines
      Line Width: 0.1
      Name: Global Path (Centerline)
      Offset:
        X: 0
        Y: 0
        Z: 0.35
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.4
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/global_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/route_ribbon
      Name: Active Route (Solid 3.8m Road Carpet)
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/route_centerline
      Name: Route Centerline (White)
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/vehicle_marker
      Name: saye Buggy (Live 3D Model)
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/safety_corridor
      Name: Safety Corridor (Dynamic Bounds)
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/safety_threats
      Name: Detected Threats & Obstacles
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RealSense Camera Feed
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /real_sense/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 33; 39
    Fixed Frame: map
    Frame Rate: 120
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 32.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 1.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Third Person Buggy View
      Near Clip Distance: 0.1
      Pitch: 0.65
      Target Frame: base_link
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 1.5708
    Saved:
      - Class: rviz_default_plugins/ThirdPersonFollower
        Distance: 32.0
        Focal Point:
          X: 0.0
          Y: 0.0
          Z: 1.0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Third Person Buggy View
        Near Clip Distance: 0.1
        Pitch: 0.65
        Target Frame: base_link
        Value: ThirdPersonFollower (rviz_default_plugins)
        Yaw: 1.5708
      - Class: rviz_default_plugins/Orbit
        Distance: 45.0
        Focal Point:
          X: 0.0
          Y: 0.0
          Z: 1.0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Orbit Buggy Follower
        Near Clip Distance: 0.1
        Pitch: 0.65
        Target Frame: base_link
        Value: Orbit (rviz_default_plugins)
        Yaw: 1.5708
      - Class: rviz_default_plugins/Orbit
        Distance: 600
        Focal Point:
          X: 590
          Y: 875
          Z: 0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Full Campus Map Overview
        Near Clip Distance: 0.1
        Pitch: 1.10
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz_default_plugins)
        Yaw: 4.71
Window Geometry:
  Displays:
    collapsed: false
  RealSense Camera Feed:
    collapsed: false
  Views:
    collapsed: false
  Height: 1040
  Width: 960
  X: 0
  Y: 0
