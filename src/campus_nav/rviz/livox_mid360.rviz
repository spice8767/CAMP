Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Livox Mid-360 Live Cloud (/cloud)1
        - /saye Buggy (Live 3D Model)1
      Splitter Ratio: 0.55
    Tree Height: 350
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 10
      Class: rviz_default_plugins/Grid
      Color: 70; 80; 95
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Reference Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 6
        Min Value: -1
        Value: true
      Axis: Z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0.0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Livox Mid-360 Live Cloud (/cloud)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.12
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/vehicle_marker
      Name: saye Buggy (Live 3D Model)
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/safety_corridor
      Name: Safety Lookahead Corridor
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/safety_threats
      Name: Detected Threat Clusters
      Value: true
  Enabled: true
  Global Options:
    Background Color: 12; 15; 20
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 26.0
      Focal Point:
        X: 0.0
        Y: -1.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Buggy Follower Livox View
      Near Clip Distance: 0.1
      Pitch: 0.55
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 1.5708
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 26.0
        Focal Point:
          X: 0.0
          Y: -1.0
          Z: 0.0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Buggy Follower Livox View
        Near Clip Distance: 0.1
        Pitch: 0.55
        Target Frame: base_link
        Value: Orbit (rviz_default_plugins)
        Yaw: 1.5708
      - Class: rviz_default_plugins/Orbit
        Distance: 45.0
        Focal Point:
          X: 817.0
          Y: 725.0
          Z: 1.0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: World Fixed Livox View
        Near Clip Distance: 0.1
        Pitch: 0.65
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz_default_plugins)
        Yaw: 4.71
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 520
  Width: 960
  X: 960
  Y: 0
